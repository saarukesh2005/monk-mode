{
  "name": "monk-mode",
  "private": true,
  "version": "1.1.0",
  "description": "MONK MODE — Discipline is a system. Offline focus, blocking and planning for macOS, Windows and Android.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/desktop",
    "extensions/shared"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w apps/desktop",
    "desktop:dev": "npm run tauri -w apps/desktop -- dev",
    "desktop:build": "npm run tauri -w apps/desktop -- build",
    "extensions:build": "node scripts/build-extensions.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:android": "cd apps/android && ./gradlew testDebugUnitTest",
    "verify": "npm run typecheck && npm test && npm run test:rust"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.5"
  }
}

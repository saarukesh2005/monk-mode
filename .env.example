# MONK MODE needs no API keys, accounts or cloud services.
# These optional variables only affect local development builds.

# Android SDK location (Android Studio default on macOS shown).
ANDROID_HOME=$HOME/Library/Android/sdk

# JDK 17 used by Gradle for the Android build.
JAVA_HOME=/path/to/jdk-17

# Port for the loopback-only desktop <-> browser-extension bridge (default 47613).
MONK_BRIDGE_PORT=47613
